# Where the Park'd backend (Express + MongoDB + Socket.io) runs.
# Local dev: leave empty — Vite proxies /api and /socket.io to http://localhost:4000.
# Deployed (Vercel): set to your backend URL, e.g. https://parkd-api.onrender.com
VITE_API_URL=

# Google OAuth Web client ID (public; configure the same ID on the backend).
VITE_GOOGLE_CLIENT_ID=
