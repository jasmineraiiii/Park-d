# Copy to .env and fill in your local or MongoDB Atlas credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/parkchd

# Replace with a long, random secret before deployment.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: without a key, the assistant uses its rules fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CORS_ORIGIN=*
PORT=4000
SIMULATE=false
